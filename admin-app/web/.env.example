# Nenhum valor abaixo é segredo -- são os mesmos que já estavam em
# public/admin/config.yml (Decap), que esta SPA substitui. Os defaults em
# src/lib/env.ts já cobrem produção; só precisa de um .env.local aqui se for
# apontar pra outro repo/worker em dev.

VITE_GH_OWNER=urubiciguia-max
VITE_GH_REPO=novo-guia-urubici
VITE_GH_BRANCH=main
VITE_OAUTH_WORKER_BASE_URL=https://guia-urubici-cms-oauth.urubiciguia.workers.dev
VITE_OAUTH_SCOPE=public_repo
VITE_SITE_URL=https://novo-guia-urubici.pages.dev

# Liga o client MOCK (dados fake em memória, sem rede/token real) -- só tem
# efeito com `npm run dev` (import.meta.env.DEV); em build de produção essa
# ramificação é eliminada do bundle. Ver src/lib/mockClient.ts.
VITE_MOCK=1
