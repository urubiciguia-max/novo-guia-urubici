---
import { Image } from 'astro:assets';
import logo from '../assets/logo.webp';
import CategoryNav from './CategoryNav.astro';
---

<header class="site-header">
  <div class="container header-inner">
    <div class="header-brand">
      <a href="/" class="wordmark">
        <Image src={logo} alt="Guia de Urubici" width={220} height={123} loading="eager" />
      </a>

      <!-- pills de categoria ao lado da logo — só no desktop (>=860px) -->
      <div class="header-categories header-categories--desktop">
        <CategoryNav variant="inline" />
      </div>
    </div>

    <a href="/guia-pratico" class="btn btn--green header-cta">Ver guia prático</a>
  </div>

  <!-- mesma navegação de categorias, em formato de faixa rolável —
       só no mobile (<860px), onde não há espaço pra ficar ao lado da logo -->
  <div class="header-categories header-categories--mobile">
    <CategoryNav variant="default" />
  </div>
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 100;
    background: rgba(255, 255, 255, 0.85);
    backdrop-filter: blur(10px);
    -webkit-backdrop-filter: blur(10px);
    border-bottom: 1px solid var(--line);
  }

  .header-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    padding-block: 16px;
    flex-wrap: wrap;
  }

  .header-brand {
    display: flex;
    align-items: center;
    gap: 20px;
  }

  .wordmark {
    display: flex;
    align-items: center;
  }

  .wordmark img {
    height: 72px;
    width: auto;
  }

  .header-cta {
    white-space: nowrap;
  }

  .header-categories--desktop {
    display: none;
  }

  @media (min-width: 860px) {
    .wordmark img {
      height: 92px;
    }

    .header-categories--desktop {
      display: block;
    }

    .header-categories--mobile {
      display: none;
    }

    /* no desktop o chip "Guia Prático" já cobre o mesmo destino */
    .header-cta {
      display: none;
    }
  }
</style>
