---
const navLinks = [
  { label: 'Sobre a cidade', href: '/sobre-a-cidade' },
  { label: 'Roteiros', href: '/roteiros' },
  { label: 'Onde ficar', href: '/onde-ficar' },
  { label: 'Pra levar', href: '/pra-levar' },
  { label: 'Negócios locais', href: '/negocios-locais' },
];
---

<header class="site-header">
  <div class="container header-inner">
    <a href="/" class="wordmark">
      Guia<span class="wordmark-accent">Urubici</span>
    </a>

    <!--
      Menu mobile 100% CSS via <details>/<summary> — disclosure nativo,
      sem JS. <summary> ja vem com foco/teclado/aria-expanded de fabrica.
      Em >=860px o <details> é "desmontado" visualmente via CSS (display:
      contents) e o painel de nav fica sempre visivel na horizontal.
    -->
    <details class="nav-disclosure">
      <summary class="nav-toggle" aria-label="Abrir menu de navegação">
        <span class="nav-toggle-icon" aria-hidden="true"></span>
      </summary>

      <nav class="nav-panel" aria-label="Navegação principal">
        <ul class="nav-list">
          {navLinks.map((link) => (
            <li>
              <a href={link.href} class="link-under">{link.label}</a>
            </li>
          ))}
        </ul>
        <a href="/roteiros" class="btn btn--coral nav-cta">Ver roteiros</a>
      </nav>
    </details>
  </div>
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 100;
    background: rgba(255, 255, 255, 0.85);
    backdrop-filter: blur(10px);
    -webkit-backdrop-filter: blur(10px);
    border-bottom: 1px solid var(--line);
  }

  .header-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding-block: 16px;
  }

  .wordmark {
    font-family: var(--font-display);
    font-weight: 800;
    font-size: 1.25rem;
    color: var(--ink);
    white-space: nowrap;
  }

  .wordmark-accent {
    color: var(--coral);
  }

  /* --- toggle (hamburger / summary) --- */

  .nav-disclosure {
    position: relative;
  }

  .nav-toggle {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 44px;
    height: 44px;
    border-radius: var(--radius-pill);
    cursor: pointer;
    list-style: none;
  }

  .nav-toggle::-webkit-details-marker {
    display: none;
  }

  .nav-toggle:hover {
    background: var(--bg-soft);
  }

  .nav-toggle-icon,
  .nav-toggle-icon::before,
  .nav-toggle-icon::after {
    display: block;
    width: 20px;
    height: 2px;
    background: var(--ink);
    border-radius: 2px;
    transition: transform var(--ease), opacity var(--ease);
  }

  .nav-toggle-icon {
    position: relative;
  }

  .nav-toggle-icon::before,
  .nav-toggle-icon::after {
    content: '';
    position: absolute;
    left: 0;
  }

  .nav-toggle-icon::before {
    top: -6px;
  }

  .nav-toggle-icon::after {
    top: 6px;
  }

  .nav-disclosure[open] .nav-toggle-icon {
    background: transparent;
  }

  .nav-disclosure[open] .nav-toggle-icon::before {
    top: 0;
    transform: rotate(45deg);
  }

  .nav-disclosure[open] .nav-toggle-icon::after {
    top: 0;
    transform: rotate(-45deg);
  }

  /* --- painel de navegacao (mobile = drawer abaixo do header) --- */

  .nav-panel {
    position: absolute;
    top: calc(100% + 8px);
    right: 0;
    left: 0;
    background: #fff;
    border: 1px solid var(--line);
    border-radius: var(--radius-card);
    box-shadow: 0 16px 32px rgba(26, 26, 26, 0.12);
    padding: 16px;
    display: flex;
    flex-direction: column;
    gap: 16px;
  }

  .nav-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 14px;
    font-weight: 500;
  }

  .nav-cta {
    width: 100%;
  }

  @media (min-width: 860px) {
    .nav-disclosure {
      display: contents;
    }

    .nav-toggle {
      display: none;
    }

    /* sobrescreve a regra nativa "details:not([open]) > *:not(summary){display:none}" */
    .nav-panel {
      display: flex !important;
      position: static;
      flex-direction: row;
      align-items: center;
      gap: 32px;
      border: none;
      box-shadow: none;
      padding: 0;
      background: transparent;
    }

    .nav-list {
      flex-direction: row;
      gap: 28px;
    }

    .nav-cta {
      width: auto;
    }
  }
</style>
