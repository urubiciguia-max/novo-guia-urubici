---
import CategoryNav from './CategoryNav.astro';

interface Props {
  href: string;
  title: string;
  excerpt: string;
}

const { href, title, excerpt } = Astro.props;
---

<section class="hero section container" aria-label="Post em destaque">
  <div class="hero-card placeholder-gradient">
    <a href={href} class="hero-card-link" aria-label={title}></a>

    <span class="badge badge--charcoal hero-badge">Último post</span>

    <div class="hero-categories">
      <CategoryNav variant="overlay" />
    </div>

    <div class="hero-overlay">
      <h2 class="hero-title"><a href={href} class="hero-title-link">{title}</a></h2>
      <p class="hero-excerpt">{excerpt}</p>
      <a href={href} class="hero-link link-under">Ler o post completo</a>
    </div>
  </div>
</section>

<style>
  .hero {
    padding-top: 32px;
  }

  .hero-card {
    position: relative;
    display: block;
    aspect-ratio: 21 / 9;
    border-radius: var(--radius-card);
    overflow: hidden;
    isolation: isolate;
  }

  /* placeholder: no mockup real seria uma foto da serra; aqui e gradiente */
  .hero-card.placeholder-gradient {
    background-image: linear-gradient(135deg, var(--green-dark) 0%, var(--green) 65%, var(--green-dark) 130%);
  }

  .hero-card::after {
    content: '';
    position: absolute;
    inset: 0;
    z-index: 1;
    background: linear-gradient(to top, rgba(0, 0, 0, 0.65) 0%, rgba(0, 0, 0, 0.1) 55%, transparent 100%);
  }

  /* cobre o card inteiro e manda o clique pro post; fica abaixo do badge,
     das categorias e do overlay de texto, que tem seus proprios links */
  .hero-card-link {
    position: absolute;
    inset: 0;
    z-index: 2;
  }

  .hero-badge {
    position: absolute;
    top: 20px;
    left: 20px;
    z-index: 3;
  }

  .hero-categories {
    position: absolute;
    top: 64px;
    left: 20px;
    right: 20px;
    z-index: 3;
  }

  .hero-overlay {
    position: absolute;
    inset: auto 0 0 0;
    z-index: 3;
    padding: 20px;
    color: #fff;
    max-width: 720px;
    /* deixa cliques "vazarem" pro hero-card-link, exceto nos links de verdade */
    pointer-events: none;
  }

  .hero-overlay a {
    pointer-events: auto;
  }

  .hero-title {
    color: #fff;
    font-size: clamp(1.25rem, 4vw, 2rem);
    margin-bottom: 8px;
  }

  .hero-excerpt {
    color: rgba(255, 255, 255, 0.88);
    font-size: 0.95rem;
    margin-bottom: 10px;
    display: none;
  }

  .hero-link {
    font-weight: 600;
    font-size: 0.9rem;
  }

  .hero-link::after {
    background: #fff;
  }

  @media (min-width: 860px) {
    .hero-overlay {
      padding: 32px 40px;
    }

    .hero-excerpt {
      display: block;
    }
  }
</style>
