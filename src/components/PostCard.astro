---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  href: string;
  title: string;
  excerpt: string;
  tag: string;
  image?: ImageMetadata;
  imageAlt?: string;
}

const { href, title, excerpt, tag, image, imageAlt } = Astro.props;
---

<a href={href} class="post-card card">
  <div class:list={['post-card-thumb', { 'placeholder-gradient': !image }]}>
    {image ? (
      <Image src={image} alt={imageAlt ?? ''} class="post-card-image" />
    ) : (
      <span aria-hidden="true" class="post-card-image"></span>
    )}
  </div>
  <div class="post-card-body">
    <span class="badge badge--charcoal">{tag}</span>
    <h3 class="post-card-title">{title}</h3>
    <p class="post-card-excerpt">{excerpt}</p>
  </div>
</a>

<style>
  .post-card {
    display: flex;
    flex-direction: column;
    overflow: hidden;
  }

  .post-card-thumb {
    aspect-ratio: 4 / 3;
    overflow: hidden;
  }

  /* placeholder: usado so quando o post nao tem `cover` no frontmatter.
     azul hardcoded (#2d6ea8) aposentado junto com --navy: nao existe azul
     na paleta nova. Gradiente direto charcoal -> amber, sem meio-termo. */
  .post-card-thumb.placeholder-gradient {
    background-image: linear-gradient(135deg, var(--charcoal) 0%, var(--amber) 130%);
  }

  .post-card-image {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .post-card-body {
    padding: 18px;
    display: flex;
    flex-direction: column;
    gap: 10px;
  }

  .post-card-title {
    font-size: 1.05rem;
  }

  .post-card-excerpt {
    font-size: 0.9rem;
    margin: 0;
  }
</style>
