---
interface Category {
  label: string;
  href: string;
}

interface Props {
  variant?: 'default' | 'overlay';
}

const { variant = 'default' } = Astro.props;

const categories: Category[] = [
  { label: 'Guia Prático', href: '/guia-pratico' },
  { label: 'O Que Fazer', href: '/o-que-fazer' },
  { label: 'Onde Comer', href: '/onde-comer-urubici' },
  { label: 'Onde Ficar', href: '/onde-ficar' },
];
---

<nav class={`category-nav ${variant === 'overlay' ? 'category-nav--overlay' : ''}`} aria-label="Categorias do blog">
  <ul class={variant === 'overlay' ? 'category-list' : 'container category-list'}>
    {categories.map((cat) => (
      <li>
        <a href={cat.href} class="category-pill">{cat.label}</a>
      </li>
    ))}
  </ul>
</nav>

<style>
  .category-nav {
    border-bottom: 1px solid var(--line);
  }

  .category-list {
    display: flex;
    gap: 10px;
    list-style: none;
    margin: 0;
    padding-block: 16px;
    overflow-x: auto;
    scrollbar-width: thin;
    -webkit-overflow-scrolling: touch;
  }

  .category-list li {
    flex: 0 0 auto;
  }

  .category-pill {
    display: inline-flex;
    align-items: center;
    padding: 8px 18px;
    border-radius: var(--radius-pill);
    background: var(--bg-soft);
    font-size: 0.875rem;
    font-weight: 600;
    color: var(--ink);
    white-space: nowrap;
    transition: background-color var(--ease), color var(--ease);
  }

  .category-pill:hover,
  .category-pill:focus-visible {
    background: var(--green);
    color: #fff;
  }

  /* variante "overlay": pousa sobre a foto do hero, sem fundo/borda proprios */
  .category-nav--overlay {
    border-bottom: none;
  }

  .category-nav--overlay .category-list {
    padding-block: 0;
  }

  .category-nav--overlay .category-pill {
    background: rgba(255, 255, 255, 0.16);
    backdrop-filter: blur(6px);
    -webkit-backdrop-filter: blur(6px);
    color: #fff;
    border: 1px solid rgba(255, 255, 255, 0.35);
  }

  .category-nav--overlay .category-pill:hover,
  .category-nav--overlay .category-pill:focus-visible {
    background: var(--green);
    border-color: var(--green);
    color: #fff;
  }
</style>
