---
import { getCollection, type CollectionEntry } from 'astro:content';
import { Image } from 'astro:assets';
import Layout from '../layouts/Layout.astro';
import DisclosureStrip from './DisclosureStrip.astro';
import Header from './Header.astro';
import Footer from './Footer.astro';
import Breadcrumb from './Breadcrumb.astro';
import AuthorBox from './AuthorBox.astro';
import FAQAccordion from './FAQAccordion.astro';
import AffiliateBox from './AffiliateBox.astro';
import RelatedPosts from './RelatedPosts.astro';
import Article from './schema/Article.astro';
import FAQPage from './schema/FAQPage.astro';
import BreadcrumbList from './schema/BreadcrumbList.astro';

/**
 * Template completo de um post (capa, AuthorBox, header, corpo via
 * `<Content />`, affiliate boxes, FAQAccordion, posts relacionados) + os 3
 * schemas JSON-LD (`Article`, `FAQPage` condicional, `BreadcrumbList`) + o
 * `<Layout>` em volta -- extraido de `src/pages/[...slug].astro` pra virar
 * reusavel.
 *
 * Quem usa isso hoje:
 * - `src/pages/[...slug].astro` -- renderiza QUALQUER post individual (o
 *   caso normal), com `breadcrumbItems` incluindo o titulo do post como
 *   ultimo nivel.
 * - As 4 hub pages de categoria (`o-que-fazer.astro`, `guia-pratico.astro`,
 *   `onde-comer-urubici.astro`, `onde-ficar.astro`) -- quando o silo tem
 *   EXATAMENTE 1 post publicado, a URL do silo renderiza o artigo inteiro
 *   direto por aqui, SEM listagem no meio (ver `RESERVED_HUB_SLUGS` em
 *   `src/lib/reservedHubSlugs.ts`). Nesse caso o `breadcrumbItems` passado
 *   e so "Inicio > Nome do Silo" -- SEM mais um nivel com o titulo do post,
 *   ja que o silo E o post sao a mesma pagina.
 *
 * `breadcrumbItems` fica como PROP (quem chama decide o que aparece) --
 * `canonicalUrl`/`resolvedOgImage`/`relatedPosts` ficam calculados aqui
 * dentro, porque só dependem do `post` recebido.
 */
interface Crumb {
  name: string;
  url: string;
}

interface Props {
  post: CollectionEntry<'posts'>;
  breadcrumbItems: Crumb[];
}

const { post, breadcrumbItems } = Astro.props;
const { Content } = await post.render();

const allPosts = await getCollection('posts', ({ data }) => !data.draft);
const relatedPosts = (post.data.relatedSlugs ?? [])
  .map((slug) => allPosts.find((p) => p.slug === slug))
  .filter((p): p is CollectionEntry<'posts'> => Boolean(p))
  .map((p) => ({
    href: `/${p.slug}`,
    title: p.data.title,
    excerpt: p.data.description,
    tag: p.data.category,
  }));

const canonicalUrl = new URL(`/${post.slug}`, Astro.site).toString();
const resolvedOgImage = new URL(post.data.cover?.src ?? '/og-default.jpg', Astro.site).toString();
---

<Layout
  title={post.data.title}
  description={post.data.description}
  ogType="article"
  ogImage={post.data.cover?.src}
>
  <Article
    slot="schema"
    headline={post.data.title}
    description={post.data.description}
    image={resolvedOgImage}
    datePublished={post.data.pubDate}
    dateModified={post.data.updatedDate}
    authorName={post.data.author}
    url={canonicalUrl}
  />
  {post.data.faq && post.data.faq.length > 0 && (
    <FAQPage slot="schema" items={post.data.faq} />
  )}
  <BreadcrumbList slot="schema" items={breadcrumbItems} />

  <DisclosureStrip />
  <Header />

  <main id="conteudo-principal">
    <div class="container">
      <Breadcrumb items={breadcrumbItems} />
    </div>

    <article class="post container">
      {post.data.cover && (
        <figure class="post-cover">
          <Image
            src={post.data.cover}
            alt={post.data.coverAlt ?? ''}
            loading="eager"
            fetchpriority="high"
          />
          {post.data.coverCredit && <figcaption class="post-cover__credit">{post.data.coverCredit}</figcaption>}
        </figure>
      )}

      <AuthorBox author={post.data.author} pubDate={post.data.pubDate} updatedDate={post.data.updatedDate} />

      <header class="post-header">
        <span class="badge badge--charcoal">{post.data.category}</span>
        <h1>{post.data.title}</h1>
        <p class="post-description">{post.data.description}</p>
      </header>

      <div class="post-body">
        <Content />
      </div>

      {post.data.affiliates && post.data.affiliates.length > 0 && (
        <div class="post-affiliates">
          {post.data.affiliates.map((affiliate) => (
            <AffiliateBox label={affiliate.label} url={affiliate.url} provider={affiliate.provider} />
          ))}
        </div>
      )}

      {post.data.faq && post.data.faq.length > 0 && <FAQAccordion items={post.data.faq} />}
    </article>

    {relatedPosts.length > 0 && (
      <div class="container">
        <RelatedPosts posts={relatedPosts} />
      </div>
    )}
  </main>

  <Footer />
</Layout>

<style>
  .post {
    max-width: 760px;
    padding-top: 24px;
    padding-bottom: 24px;
  }

  .post-header {
    margin-top: 24px;
    margin-bottom: 20px;
  }

  .post-header h1 {
    font-size: clamp(1.8rem, 4vw, 2.6rem);
    margin-top: 10px;
    margin-bottom: 10px;
  }

  .post-description {
    font-size: 1.05rem;
    margin: 0 0 20px;
  }

  .post-cover {
    margin: 0 0 20px;
  }

  .post-cover img {
    width: 100%;
    height: auto;
    border-radius: var(--radius-card);
    display: block;
  }

  .post-cover__credit {
    margin-top: 6px;
    font-size: 0.78rem;
    color: var(--body-text);
  }

  .post-body {
    margin-top: 24px;
    font-size: 1rem;
  }

  .post-body :global(h2) {
    font-size: clamp(1.25rem, 2.5vw, 1.5rem);
    margin-top: 32px;
    margin-bottom: 12px;
  }

  .post-body :global(h3) {
    font-size: 1.1rem;
    margin-top: 20px;
    margin-bottom: 8px;
  }

  .post-body :global(h4) {
    font-size: 1rem;
    margin-top: 16px;
    margin-bottom: 6px;
  }

  .post-body :global(ul),
  .post-body :global(ol) {
    padding-left: 1.25em;
    margin: 0 0 1em;
  }

  .post-body :global(blockquote) {
    margin: 0 0 1.5em;
    padding: 12px 18px;
    border-left: 3px solid var(--green);
    background: var(--bg-soft);
    border-radius: 0 var(--radius-card) var(--radius-card) 0;
    font-size: 0.95rem;
  }

  /*
   * Caixa "Destaque" (Dica / Atenção / Importante) -- gerada a partir de um
   * blockquote com marcador `[!DICA]`/`[!ATENCAO]`/`[!IMPORTANTE]` por
   * `src/lib/remark-destaque.mjs` (remark plugin, build time). O plugin já
   * troca a tag pra <div class="destaque destaque--<tipo>">, então isso não
   * conflita com `.post-body :global(blockquote)` acima -- citação normal
   * continua sendo <blockquote> de verdade, sem o marcador.
   */
  .post-body :global(.destaque) {
    margin: 0 0 1.5em;
    padding: 14px 18px;
    border-left: 3px solid var(--green);
    background: var(--bg-soft);
    border-radius: 0 var(--radius-card) var(--radius-card) 0;
    font-size: 0.95rem;
  }

  .post-body :global(.destaque__label) {
    margin: 0 0 6px;
    font-family: var(--font-display);
    font-weight: 700;
    color: var(--ink);
  }

  .post-body :global(.destaque p:last-child) {
    margin-bottom: 0;
  }

  .post-body :global(.destaque--dica) {
    border-left-color: var(--green);
  }

  .post-body :global(.destaque--atencao) {
    border-left-color: var(--amber);
  }

  .post-body :global(.destaque--importante) {
    border-left-color: var(--red);
  }

  .post-body :global(a) {
    color: var(--green);
    text-decoration: underline;
    text-underline-offset: 2px;
  }

  .post-affiliates {
    margin-top: 24px;
  }
</style>
