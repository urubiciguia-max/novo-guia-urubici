---
import { getCollection, type CollectionEntry } from 'astro:content';
import PostArticle from '../components/PostArticle.astro';
import { RESERVED_HUB_SLUGS } from '../lib/reservedHubSlugs';

/**
 * Catch-all de posts — slug plano na raiz, sem prefixo de categoria (ex:
 * /cachoeiras-secretas-urubici/), pra manter 100% da URL equity do WP antigo
 * (ver nota em src/content/config.ts). O slug da Content Collection vem do
 * nome do arquivo em src/content/posts/ (sem subpastas) — por isso
 * `post.slug` ja cai certinho na raiz, sem precisar de logica extra aqui.
 *
 * Paginas institucionais estaticas (sobre-nos.astro, contato.astro, etc.) e
 * as hub pages (guia-pratico.astro, etc.) SAO rotas estaticas e o Astro
 * prioriza elas sobre esta rota dinamica -- MAS SEM AVISAR NADA quando um
 * post usa o mesmo slug de uma dessas rotas: o Astro so sobrescreve o
 * arquivo gerado em `dist/` em silencio, sem erro nem warning no build
 * (confirmado rodando `npm run build` e inspecionando `dist/` -- o
 * comentario antigo aqui dizia que "o build ia falhar com rota duplicada",
 * isso NAO e verdade na pratica e foi a causa raiz de um bug real em
 * producao: o post `o-que-fazer.md` ficou inacessivel porque
 * `o-que-fazer.astro` sobrescrevia ele no disco).
 *
 * Por isso os slugs das 4 hub pages de categoria (`RESERVED_HUB_SLUGS`, ver
 * src/lib/reservedHubSlugs.ts) sao EXCLUIDOS daqui -- quando o silo tem
 * exatamente 1 post publicado, e a PROPRIA hub page que renderiza o artigo
 * inteiro (via `src/components/PostArticle.astro`), entao essa rota nunca
 * precisa competir por essa URL.
 *
 * Gera paginas pra TODOS os outros posts, incluindo draft — e intencional
 * nesta fase de scaffold (so existe conteudo de exemplo, nada linkado de
 * verdade nas hub pages/nav, que ja filtram draft). Antes do go-live com
 * conteudo real (Fase 4), avaliar gate por `import.meta.env.PROD` se quiser
 * blindar tambem a pagina individual.
 */
export async function getStaticPaths() {
  const posts = await getCollection('posts');
  return posts
    .filter((post) => !RESERVED_HUB_SLUGS.includes(post.slug as (typeof RESERVED_HUB_SLUGS)[number]))
    .map((post) => ({
      params: { slug: post.slug },
      props: { post },
    }));
}

interface Props {
  post: CollectionEntry<'posts'>;
}

const { post } = Astro.props;

const CATEGORY_HUB: Partial<Record<CollectionEntry<'posts'>['data']['category'], string>> = {
  'Guia Prático': '/guia-pratico',
  'O Que Fazer': '/o-que-fazer',
  'Onde Comer': '/onde-comer-urubici',
};

const breadcrumbItems = [
  { name: 'Início', url: '/' },
  ...(CATEGORY_HUB[post.data.category]
    ? [{ name: post.data.category, url: CATEGORY_HUB[post.data.category]! }]
    : []),
  { name: post.data.title, url: `/${post.slug}` },
];
---

<PostArticle post={post} breadcrumbItems={breadcrumbItems} />
